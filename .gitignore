# ==============================================================================
# Pianoteq 9 逆向与声学实验室 - Git 忽略规则 (.gitignore)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 专有商业二进制与受版权保护资产 (Copyright & Proprietary Assets)
# ------------------------------------------------------------------------------
# 严禁将任何商业二进制、插件、音色库、官方手册或专有配置提交到版本控制仓库
/binaries/

# 根目录或任意子目录下意外散落的原生二进制文件与专有扩展
*.exe
*.dll
*.vst3
*.vst3plugin
*.dylib
*.so
*.ptq
*.fxp

# ------------------------------------------------------------------------------
# 2. 媒体与实验渲染产物 (Audio & Media Artifacts)
# ------------------------------------------------------------------------------
# 原始音频按散列离线保留；复算不等于能重新生成缺少历史渲染条件的样本
/acoustic_lab/audio/*
!/acoustic_lab/audio/.gitkeep

# 本机封存包含原始音频和重建输入，不进入 Git 或默认发布
/acoustic_lab/backups/

# 常见音频导出临时格式
*.wav
*.aif
*.aiff
*.flac
*.mp3

# ------------------------------------------------------------------------------
# 3. 逆向工程与反编译器缓存 (Reverse Engineering & Ghidra / REA)
# ------------------------------------------------------------------------------
# Ghidra Headless / GUI 项目文件与临时数据库
*.gpr
*.rep/
*.lock
*.hprof
*.db-journal
*.db-wal
*.db-shm

# REA / Hopper / IDA 临时会话与缓存目录
.rea/
rea-cache/
*.idb
*.i64
*.nam
*.til

# ------------------------------------------------------------------------------
# 4. Python 运行环境与依赖缓存 (Python Environment & Caches)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 虚拟环境目录
.venv/
venv/
ENV/
env/

# ------------------------------------------------------------------------------
# 5. OMP Agent 本地运行时日志与缓存 (OMP Local Runtime)
# ------------------------------------------------------------------------------
.omp/logs/
.omp/cache/
.omp/run/
# 保留项目级 MCP 配置文件：
!.omp/mcp.json

# ------------------------------------------------------------------------------
# 6. 操作系统与编辑器临时文件 (OS & IDE Artifacts)
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 编辑器与 IDE
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo
*~
