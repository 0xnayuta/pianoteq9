  "claims": {
    "envelope_explanation": "The fixed AM model predicts held-out raw stereo samples and recovers a conditional carrier/envelope in the finite synthetic domain. It does not identify a physical source.",
    "static_single_component": "Only the untouched partial-observer result is recorded. AM model success never changes or overrides its status or feeds a B fit.",
    "nonidentifiability": "exp(-d t)*(1+m cos(wm t+psi))*cos(wc t+phi) equals three phase-coherent damped sinusoids at fc and fc +/- fm. Distinct generator labels are observationally nonidentifiable."
  },
  "roles": {
    "development": "Implementation debugging; never reported as independent qualification.",
    "qualification": "Execute complete disjoint cases once after a sealed source manifest; retain failed records. No new role or subset can restore unused qualification after inspection."
  },
  "generator": {
    "duration_s": 4.2,
    "pcm_bits": 24,
    "channels": 2,
    "right_gain": 0.8,
    "right_phase_offset_rad": 0.31,
    "am_formula": "A exp(-d t)*(1+m cos(2pi fm t+psi))*cos(2pi fc t+phi_ch)",
    "triplet_formula": "A exp(-d t)*(cos(2pi fc t+phi_ch)+(m/2)cos(2pi(fc+fm)t+phi_ch+psi)+(m/2)cos(2pi(fc-fm)t+phi_ch-psi))",
    "negative_formulas": {
      "asymmetric_triplet": "lower side amplitude m/2, upper side amplitude 0.35*m/2, upper phase additionally +0.7 rad",
      "beating_doublet": "A exp(-d t)*(cos(2pi(fc-fm/2)t+phi_ch)+cos(2pi(fc+fm/2)t+phi_ch+0.9))",
      "fm": "A exp(-d t)*cos(2pi fc t+phi_ch+(0.65/fm)*sin(2pi fm t+psi))",
      "chirp": "A exp(-d t)*cos(2pi*(fc*t+0.4*t*t)+phi_ch)",
      "noise": "noise only",
      "constant_decay": "A exp(-d t)*cos(2pi fc t+phi_ch)",
      "slow_unidentifiable_am": "AM product below the preregistered identifiable modulation band"
    },
    "roundtrip": "Round to nearest signed24 samples, no normalization/clipping; fail any sample >=0.95; independent Gaussian channel noise from per-case seed. Equivalent pair shares seed as intentional matched control, roles have disjoint seeds."
  },
